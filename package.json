  "dependencies": {
    "@google-cloud/storage": "^7.0.0",
    "axios": "^1.5.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.0.0",
    "express": "^5.1.0",
    "exceljs": "^4.3.0",
    "form-data": "^4.0.0",
    "node-cron": "^3.0.2"
  }
